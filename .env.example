# App settings. Copy to .env.local to change them; everything works without this file.

# 1 (default) replays recorded conversations with no keys and no network.
# 0 uses your microphone, the ElevenLabs persona and the Claude grader via /server.
EXPO_PUBLIC_MOCK=1

# Where the app reaches /server. On a phone this must be your computer's LAN address,
# not localhost. Provider keys live in server/.env, never here.
EXPO_PUBLIC_SERVER_URL=http://192.168.1.20:8787

# RevenueCat Test Store public SDK key (starts with test_). Public SDK keys are designed to ship
# inside apps; no secret key is used anywhere. Development builds only: the SDK crashes release
# builds that contain a Test Store key. See docs/REVENUECAT.md.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
