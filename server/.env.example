# Copy to server/.env. Each block is optional; the server turns on whatever is configured.

# Grader: Claude. The persona runs on a different model family (Gemini, inside ElevenLabs),
# so the grader never marks its own roleplay.
ANTHROPIC_API_KEY=
GRADER_MODEL=claude-opus-5
GRADER_EFFORT=medium

# Persona voice: ElevenLabs Agents. See docs/DEVICE.md for the agent settings.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

PORT=8787
