# Copy to server/.env. Each block is optional; the server turns on whatever is configured.

# Grader, drafter and safety check: ONE of the two options below. The persona runs on a
# different model family inside ElevenLabs, so the grader never marks its own roleplay.

# Option 1: Claude (what the grader is calibrated on). The model lines are optional overrides.
ANTHROPIC_API_KEY=
# GRADER_MODEL=claude-opus-5
# SAFETY_MODEL=claude-opus-5
# DRAFTER_MODEL=claude-opus-5-5

# Option 2, free: any OpenAI-compatible API, used when ANTHROPIC_API_KEY is empty. GRADER_MODEL
# is required; the drafter and safety check use it too unless DRAFTER_MODEL or SAFETY_MODEL say
# otherwise.
# Gemini's free tier (key from https://aistudio.google.com/apikey; then give the ElevenLabs
# persona a non-Gemini LLM):
#   MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   MODEL_API_KEY=your-gemini-key
#   GRADER_MODEL=gemini-2.5-flash
# A local Ollama model (runs on your GPU; `ollama pull qwen2.5:7b`, then `ollama serve`):
#   MODEL_BASE_URL=http://localhost:11434/v1
#   GRADER_MODEL=qwen2.5:7b
MODEL_BASE_URL=
MODEL_API_KEY=
GRADER_MODEL=

GRADER_EFFORT=medium

# Persona voice: ElevenLabs Agents. See docs/DEVICE.md for the agent settings.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

PORT=8787
