{
  "name": "hardtalk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --go",
    "web": "expo start --go --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start:live": "EXPO_PUBLIC_MOCK=0 expo start --dev-client",
    "start:server": "pnpm --filter hardtalk-server start",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=server/.env evals/run.ts",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@elevenlabs/client": "1.25.0",
    "@elevenlabs/react-native": "1.2.27",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-expo-plugin": "^1.0.3",
    "@livekit/react-native-webrtc": "^144.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "livekit-client": "^2.22.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "^10.10.2",
    "react-native-purchases-ui": "^10.10.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@types/node": "^20.19.43",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.32.1"
}
